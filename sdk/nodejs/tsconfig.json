{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "apikey/getId.ts",
        "apikey/index.ts",
        "config/index.ts",
        "config/vars.ts",
        "index.ts",
        "privateendpoint/getConfig.ts",
        "privateendpoint/index.ts",
        "privateendpoint/registration.ts",
        "provider.ts",
        "service.ts",
        "serviceprivateendpoints/attachment.ts",
        "serviceprivateendpoints/index.ts",
        "servicetransparentdataencryptionkey/association.ts",
        "servicetransparentdataencryptionkey/index.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
